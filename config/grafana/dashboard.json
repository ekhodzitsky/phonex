{
  "id": null,
  "title": "phonex",
  "tags": ["phonex"],
  "timezone": "browser",
  "schemaVersion": 36,
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "title": "HTTP Request Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(requests_total[1m])",
          "legendFormat": "{{method}} {{path}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "title": "Request Duration (p99)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(request_duration_seconds_bucket[1m]))",
          "legendFormat": "p99"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },
    {
      "id": 3,
      "title": "WebSocket Connections",
      "type": "stat",
      "targets": [
        {
          "expr": "ws_connections_total",
          "legendFormat": "Connections"
        }
      ],
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 }
    },
    {
      "id": 4,
      "title": "Pool Availability",
      "type": "stat",
      "targets": [
        {
          "expr": "pool_available / pool_total",
          "legendFormat": "Available %"
        }
      ],
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 }
    },
    {
      "id": 5,
      "title": "WS Messages",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(ws_messages_total[1m])",
          "legendFormat": "messages/sec"
        }
      ],
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 }
    }
  ]
}
